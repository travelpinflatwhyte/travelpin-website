    <p class="page-eyebrow">Legal</p>
    <h1>Privacy Policy</h1>
    <p class="page-date">Last updated: June 4, 2026</p>

    <div class="jurisdiction-bar">
      <span class="juris-badge india">India — DPDPA 2023</span>
